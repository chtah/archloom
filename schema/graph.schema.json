{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string",
      "const": "0.1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n\\t]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "lanes": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "lane": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "default": "service",
            "type": "string",
            "enum": [
              "service",
              "app",
              "module",
              "function",
              "route",
              "job",
              "queue",
              "datastore",
              "cache",
              "external",
              "ui",
              "config",
              "test",
              "package",
              "other"
            ]
          },
          "icon": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9_-]*$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "label",
          "lane"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "default": [],
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "default": "call",
            "type": "string",
            "enum": [
              "call",
              "http",
              "rpc",
              "event",
              "queue",
              "data",
              "dependency",
              "render",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "animated": {
            "default": true,
            "type": "boolean"
          },
          "emphasis": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "hero",
              "muted"
            ]
          },
          "readOnly": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "flows": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\t]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "participants": {
            "minItems": 2,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "messages": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[^\\r\\n\\t]*$"
                },
                "kind": {
                  "default": "sync",
                  "type": "string",
                  "enum": [
                    "sync",
                    "async",
                    "return",
                    "self"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "animated": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "from",
                "to",
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "participants",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "direction": {
          "default": "right",
          "description": "Architecture layout. right: lanes are columns left to right. down: lanes are bands stacked top to bottom. Data-flow views are unaffected.",
          "type": "string",
          "enum": [
            "right",
            "down"
          ]
        },
        "laneOrder": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "rank": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "lanes",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\r\\n\\t]*$"
        },
        "lens": {
          "type": "string",
          "enum": [
            "architecture",
            "data-flow"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "default": {
            "kind": "all"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "all"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "selection"
                },
                "lanes": {
                  "default": [],
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "nodes": {
                  "default": [],
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "edges": {
                  "default": [],
                  "maxItems": 512,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "flows": {
                  "default": [],
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "children": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "title",
        "lens"
      ],
      "additionalProperties": false
    }
  }
}
